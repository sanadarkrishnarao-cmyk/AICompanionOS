<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0B10"
    android:padding="16dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI Companion OS"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKey"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="API Key"
            android:textSize="12sp"
            android:backgroundTint="#232738"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Chat display area -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/chatDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E0E0E0"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:text="AI Companion OS Active.\nOnline (Gemini Cloud) + Offline (Local Neural Core)\n----------------------------------------\n\n" />
    </ScrollView>

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#161922"
            android:hint="Type a message..."
            android:textColorHint="#757575"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="14dp" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Send"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00E5FF"
            android:textColor="#000000" />
    </LinearLayout>

</LinearLayout>
